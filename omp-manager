def parse_version(v: str) -> tuple[int, ...]:
    """Turn 'v1.2.3' into (1, 2, 3) so versions can be compared numerically."""
    parts = []
    for chunk in v.strip().lstrip("vV").split("."):
        digits = ""
        for ch in chunk:
            if not ch.isdigit():
                break
            digits += ch
        parts.append(int(digits) if digits else 0)
    return tuple(parts)


def is_newer(remote: str, local: str) -> bool:
    return parse_version(remote) > parse_version(local)


def current_script_path() -> str:
    """Absolute path of the file that should be replaced by an update.

    `OMP_UPDATE_TARGET` wins when set: the `ompagy` wrapper uses it to point
    at `omp-manager`, so updating never overwrites the wrapper itself.
    """
    override = os.environ.get("OMP_UPDATE_TARGET")
    if override and os.path.isfile(override):
        return os.path.realpath(override)
    path = sys.argv[0]
    if not os.path.isabs(path):
        found = shutil.which(path)
        path = found if found else os.path.abspath(path)
    return os.path.realpath(path)


def _http_get(url: str, timeout: float) -> bytes:
    req = urllib.request.Request(url, headers={"User-Agent": f"omp-manager/{__version__}"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


def remote_version(force: bool = False) -> tuple[str, str]:
    """Return (version, notes) published on GitHub.

    The answer is cached for an hour so a normal run never pays for a network
    round trip more than once per hour. A failed lookup is remembered for a
    much shorter time, so a machine that was offline retries soon after
    coming back online instead of waiting a full hour.
    """
    cache_file = os.path.join(cache_dir(), "update_check.json")
    now = time.time()
    if not force:
        try:
            with open(cache_file, "r") as f:
                cached = json.load(f)
            age = now - cached.get("checkedAt", 0)
            ttl = UPDATE_CHECK_INTERVAL if cached.get("ok") else UPDATE_RETRY_INTERVAL
            if age < ttl:
                return cached.get("version", __version__), cached.get("notes", "")
        except Exception:
            pass

    version, notes, ok = __version__, "", False
    try:
        data = json.loads(_http_get(VERSION_INFO_URL, UPDATE_TIMEOUT).decode("utf-8"))
        version = str(data.get("version") or __version__)
        notes = str(data.get("description") or "")
        ok = True
    except Exception:
        pass
    try:
        with open(cache_file, "w") as f:
            json.dump({"checkedAt": now, "version": version, "notes": notes, "ok": ok}, f)
    except Exception:
        pass
    return version, notes


def try_git_pull(target: str) -> bool:
    """If the script lives inside a git checkout, update it with git.

    A git checkout keeps the full history, so `git pull --ff-only` is both
    faster and safer than downloading a single file.
    """
    repo_dir = os.path.dirname(target)
    if not os.path.isdir(os.path.join(repo_dir, ".git")):
        return False
    try:
        proc = subprocess.run(["git", "-C", repo_dir, "pull", "--ff-only", "origin", "main"],
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              timeout=30, check=False)
    except Exception:
        return False
    return proc.returncode == 0


def self_update(ink: Ink, version: str, notes: str = "") -> str:
    """Update this script to the newest published version.

    `version` is the version the caller already learned about; it is not
    fetched again here. Returns "updated", "current" or "failed".
    """
    target = current_script_path()
    if not is_newer(version, __version__):
        sys.stderr.write(ink.green(f"✓ [{PROG_NAME}] Already up to date (v{__version__}).\n"))
        return "current"

    # A git checkout is updated in place, which keeps the whole repo in sync.
    if try_git_pull(target):
        sys.stderr.write(ink.green(f"✓ [{PROG_NAME}] Updated via git pull (v{version})\n"))
        return "updated"

    try:
        payload = _http_get(RAW_SCRIPT_URL, UPDATE_TIMEOUT * 3)
    except Exception as e:
        sys.stderr.write(ink.red(f"✗ [{PROG_NAME}] Could not download update: {e}\n"))
        return "failed"

    text = payload.decode("utf-8", "replace")
    try:
        compile(text, target, "exec")  # never install a script that does not parse
    except SyntaxError as e:
        sys.stderr.write(ink.red(f"✗ [{PROG_NAME}] Downloaded file is not valid Python: {e}\n"))
        return "failed"

    if not os.access(target, os.W_OK):
        sys.stderr.write(ink.yellow(f"⚠ [{PROG_NAME}] No write permission for {target}.\n")
                         + ink.yellow(f"  Update manually: sudo {PROG_NAME} --update\n"))
        return "failed"

    tmp = f"{target}.update.{os.getpid()}"
    try:
        with open(tmp, "wb") as f:
            f.write(payload)
        os.chmod(tmp, os.stat(target).st_mode & 0o7777 or 0o755)
        os.replace(tmp, target)
    except Exception as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        sys.stderr.write(ink.red(f"✗ [{PROG_NAME}] Update failed: {e}\n"))
        return "failed"

    sys.stderr.write(ink.green(f"✓ [{PROG_NAME}] Updated v{__version__} → v{version}") +
                     (f" ({notes})\n" if notes else "\n"))
    return "updated"


def maybe_auto_update(ink: Ink) -> bool:
    """Background update check. Returns True when the script was replaced."""
    version, notes = remote_version()
    if not is_newer(version, __version__):
        return False
    target = current_script_path()
    if not os.access(target, os.W_OK):
        sys.stderr.write(ink.yellow(f"⚡ [{PROG_NAME}] v{version} is available ({notes}). "
                                    f"Run: sudo {PROG_NAME} --update\n"))
        return False
    sys.stderr.write(ink.cyan(f"⚡ [{PROG_NAME}] v{version} available ({notes}). Updating...\n"))
    if self_update(ink, version, notes) != "updated":
        return False
    # Re-exec so the user immediately sees the new version. The absolute path
    # is used (argv[0] may be a bare name that only resolves through PATH) and
    # the identity is pinned so the new process reports the same program name.
    os.environ["OMP_PROG_NAME"] = PROG_NAME
    os.execv(sys.executable, [sys.executable, target] + sys.argv[1:])
    return True  # unreachable, execv does not return


# ----------------------------------------------------------------------- main --
def main() -> None:
    ap = argparse.ArgumentParser(
        prog=PROG_NAME,
        description=f"{PROG_NAME} - Ranked Antigravity quota dashboard & multi-account manager for omp")
    ap.add_argument("--version", "-v", action="version", version=f"{PROG_NAME} {__version__}")
    ap.add_argument("--refresh", action="store_true", help="invalidate omp's cache before reading")
    ap.add_argument("--input", metavar="FILE", help="render a saved `omp usage --json` snapshot instead of fetching")
    ap.add_argument("--profile", default=config_env("PROFILE"), help="omp profile to query")
    ap.add_argument("--by", choices=sorted(PRESETS), default=config_env("BY", DEFAULT_PRESET),
                    help="what the score is weighted toward (default: gemini)")
    ap.add_argument("--sort", choices=["score", "reset", "name"], default="score",
                    help="ranking key (default: score)")
    ap.add_argument("--narrow", action="store_true", help="force stacked layout (same as --layout stack)")
    ap.add_argument("--layout", choices=["auto"] + TIER_ORDER + ["stack"], default="auto",
                    help="table density: auto shrinks the table to fit the terminal, "
                         "stack = one card per account (default: auto)")
    ap.add_argument("--mini", "-1", action="store_true", help="output a single-line summary (for tmux/prompt)")
    ap.add_argument("--json", action="store_true", help="emit the computed model as JSON")
    ap.add_argument("--color", choices=["auto", "always", "never"], default="auto")
    ap.add_argument("--stale", type=float, default=900, metavar="SEC",
                    help="warn when the oldest snapshot is older than this (default 900)")
    ap.add_argument("--timeout", type=float, default=180)
    ap.add_argument("--update", action="store_true", help="check GitHub and install the newest version now")
    ap.add_argument("--no-update", action="store_true",
                    default=config_env("NO_UPDATE") is not None,
                    help="skip the background update check")
    args = ap.parse_args()

    ink = Ink(supports_color(args.color))

    if args.update:
        version, notes = remote_version(force=True)
        status = self_update(ink, version, notes)
        sys.exit(0 if status in ("updated", "current") else 1)

    # Background update check: skipped for machine-readable output so a
    # statusline or a cron job never blocks on the network.
    if not args.no_update and not args.mini and not args.json and not args.input:
        maybe_auto_update(ink)

    payload = fetch(args, ink)
    accounts = parse(payload)
    if not accounts:
        die(ink, f"no {PROVIDER} usage reports in omp output")
    weights, preset = resolve_weights(args.by)
    for a in accounts:
        a["score"] = round(score_account(a, weights), 1)
        a["exhausted"] = exhausted_count(a)

    def reset_key(a):
        times = [e["resetsAt"] for b in BUCKETS if (e := a["buckets"].get(b)) and 0 < e["remaining"] < 100]
        return min(times) if times else float("inf")

    if args.sort == "score":
        accounts.sort(key=lambda a: (-a["score"], a["exhausted"], a["email"].lower()))
    elif args.sort == "reset":
        accounts.sort(key=lambda a: (reset_key(a), -a["score"], a["email"].lower()))
    else:
        accounts.sort(key=lambda a: a["email"].lower())
    if args.mini:
        print(render_mini(ink, payload, accounts, time.time() * 1000))
        return

    if args.json:
        now_ms = time.time() * 1000
        out = []
        for a in accounts:
            out.append({
                "email": a["email"],
                "score": round(a["score"], 2),
                "grade": grade(a["score"])[0],
                "exhaustedBuckets": a["exhausted"],
                "fetchedAt": a["fetchedAt"],
                "buckets": {
                    b: (None if b not in a["buckets"] else {
                        "usedPct": round(a["buckets"][b]["used"], 2),
                        "remainingPct": round(a["buckets"][b]["remaining"], 2),
                        "resetsAt": a["buckets"][b]["resetsAt"],
                        "resetInMs": round(a["buckets"][b]["resetsAt"] - now_ms)
                        if a["buckets"][b].get("resetsAt") else None,
                        "status": a["buckets"][b]["status"],
                    }) for b in BUCKETS
                },
                "otherMeters": a["extra"],
            })
        rec_list = [
            {
                "email": r["raw_email"],
                "bucket": r["bucket"],
                "recoverPct": round(r["recover_pct"], 2),
                "resetsAt": r["resetsAt"],
                "resetInMs": round(r["delta"]),
            } for r in get_recoveries(accounts, now_ms)
        ]
        print(json.dumps({
            "generatedAt": payload.get("generatedAt"),
            "accounts": out,
            "recoveries": rec_list,
            "capacity": (payload.get("capacity") or {}).get(PROVIDER, []),
            "today": get_today_tokens_cached(),
        }, indent=2))
        return
    print(render(ink, payload, accounts, args, weights, preset))


if __name__ == "__main__":
    main()