# ----------------------------------------------------------------- terminal --
def supports_color(force: str) -> bool:
    if force == "always":
        return True
    if force == "never":
        return False
    return sys.stdout.isatty() and os.environ.get("TERM", "") != "dumb"


class Ink:
    def __init__(self, enabled: bool):
        self.on = enabled

    def _w(self, code: str, text: str) -> str:
        if not text:
            return text
        return f"\033[{code}m{text}\033[0m" if self.on else text

    def dim(self, t: str) -> str:
        return self._w("2", t)

    def bold(self, t: str) -> str:
        return self._w("1", t)

    def green(self, t: str) -> str:
        return self._w("38;5;42", t)

    def yellow(self, t: str) -> str:
        return self._w("38;5;220", t)

    def orange(self, t: str) -> str:
        return self._w("38;5;208", t)

    def red(self, t: str) -> str:
        return self._w("38;5;203", t)

    def grey(self, t: str) -> str:
        return self._w("38;5;245", t)

    def cyan(self, t: str) -> str:
        return self._w("38;5;51", t)


def remaining_color(ink: Ink, remaining_pct: float):
    if remaining_pct <= 0:
        return ink.red
    if remaining_pct >= 50:
        return ink.green
    if remaining_pct >= 20:
        return ink.yellow
    if remaining_pct >= 5:
        return ink.orange
    return ink.red


def bar(ink: Ink, remaining_fraction: float, width: int, color) -> str:
    filled = int(round(remaining_fraction * width))
    filled = max(0, min(width, filled))
    return color("█" * filled) + ink.grey("─" * (width - filled))


# ------------------------------------------------------------------- helpers --
def fmt_delta(ms: float) -> str:
    if ms <= 0:
        return "now"
    seconds = ms / 1000.0
    days, rem = divmod(seconds, 86400)
    hours = int(rem // 3600)
    minutes = int((rem % 3600) // 60)
    secs = int(rem % 60)
    if days:
        return f"{int(days)}d{hours}h" if hours else f"{int(days)}d"
    if hours:
        return f"{hours}h{minutes:02d}m"
    if minutes >= 10:
        return f"{minutes}m"
    if minutes == 0 and secs == 0:
        return "<1s"
    return f"{minutes}m{secs:02d}s"


def fmt_age(ms: float) -> str:
    return f"{fmt_delta(ms)} ago" if ms >= 0 else "just now"

def fmt_token_num(n: float) -> str:
    if n >= 1_000_000_000:
        return f"{n/1_000_000_000:.2f}B"
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n/1_000:.1f}k"
    return str(int(n))


def get_today_tokens_cached() -> dict:
    now = datetime.now()
    today_str = now.strftime("%Y-%m-%d")
    today_start = now.replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
    sessions_dir = os.path.expanduser("~/.omp/agent/sessions")
    cache_dir_path = cache_dir()
    cache_file = os.path.join(cache_dir_path, "today_tokens.json")

    cache = {}
    if os.path.exists(cache_file):
        try:
            with open(cache_file, "r") as f:
                cache = json.load(f)
        except Exception:
            pass

    if cache.get("date") != today_str:
        cache = {"date": today_str, "files": {}, "requests": 0, "in": 0, "out": 0, "total": 0}

    cached_files = cache.get("files", {})
    updated = False

    if os.path.isdir(sessions_dir):
        for root, dirs, files in os.walk(sessions_dir):
            for f in files:
                if f.endswith(".jsonl") and not f.startswith("__"):
                    fp = os.path.join(root, f)
                    try:
                        mtime = os.path.getmtime(fp)
                        if mtime < today_start:
                            continue
                        last_mtime = cached_files.get(fp, {}).get("mtime", 0)
                        if mtime > last_mtime:
                            fin = fout = freqs = 0
                            with open(fp, "r", encoding="utf-8", errors="ignore") as file:
                                for line in file:
                                    if '"usage"' in line:
                                        try:
                                            obj = json.loads(line)
                                            u = (obj.get("message") or {}).get("usage")
                                            if u:
                                                fin += u.get("input", 0) or 0
                                                fout += u.get("output", 0) or 0
                                                freqs += 1
                                        except Exception:
                                            pass
                            cached_files[fp] = {"mtime": mtime, "in": fin, "out": fout, "reqs": freqs}
                            updated = True
                    except Exception:
                        pass

    tot_reqs = sum(v["reqs"] for v in cached_files.values())
    tot_in = sum(v["in"] for v in cached_files.values())
    tot_out = sum(v["out"] for v in cached_files.values())

    cache["requests"] = tot_reqs
    cache["in"] = tot_in
    cache["out"] = tot_out
    cache["total"] = tot_in + tot_out
    cache["files"] = cached_files

    if updated or not os.path.exists(cache_file):
        try:
            os.makedirs(cache_dir_path, exist_ok=True)
            with open(cache_file, "w") as f:
                json.dump(cache, f)
        except Exception:
            pass

    return cache


def classify(limit: dict) -> str | None:
    """Map a limit to one of the canonical buckets, or None.

    Strict on purpose: an unfamiliar meter (say `gemini-pro-5h`) must land in
    the "other meters" list rather than silently overwrite a real bucket.
    """
    tail = limit["id"].split(":")[-1].lower()
    raw_window = ((limit.get("window") or {}).get("id") or "").lower()
    window = RAW_WINDOWS.get(raw_window)
    if window is None:
        return None
    if window in ("5h", "1w"):
        for prefix, kind in (("gemini", "gemini"), ("3p", "shared")):
            if not tail.startswith(prefix):
                continue
            rest = tail[len(prefix):].lstrip("-")
            return f"{kind}-{window}" if rest in RAW_WINDOWS else None
    elif window == "daily":
        parts = limit["id"].split(":")
        vendor = parts[1].lower() if len(parts) > 1 else ""
        if vendor == "google" or "google" in tail or "gemini" in tail:
            return "gemini-daily"
        elif vendor in ("anthropic", "openai") or "3p" in tail:
            return "shared-daily"
    return None


# --------------------------------------------------------------------- parse --
def merge_limit(acc: dict, limit: dict) -> None:
    key = classify(limit)
    amount = limit.get("amount") or {}
    if key is None:
        acc["extra"].append(
            {
                "id": limit["id"],
                "label": limit.get("label", limit["id"]),
                "used": float(amount.get("used") or 0.0),
                "resetsAt": (limit.get("window") or {}).get("resetsAt"),
                "status": limit.get("status", "unknown"),
            }
        )
        return
    used = float(amount.get("used") or 0.0)
    entry = {
        "used": used,
        "remaining": float(amount.get("remaining") if amount.get("remaining") is not None else 100.0 - used),
        "resetsAt": (limit.get("window") or {}).get("resetsAt"),
        "durationMs": (limit.get("window") or {}).get("durationMs"),
        "status": limit.get("status", "unknown"),
    }
    if key in ("gemini-daily", "shared-daily"):
        target = "gemini-5h" if "gemini" in key else "shared-5h"
        if target not in acc["buckets"]:
            acc["buckets"][target] = entry
    else:
        prev = acc["buckets"].get(key)
        if prev is None or entry["used"] > prev["used"]:
            acc["buckets"][key] = entry


def parse(payload: dict) -> list[dict]:
    accounts: list[dict] = []
    for report in payload.get("reports") or []:
        if report.get("provider") != PROVIDER:
            continue
        md = report.get("metadata") or {}
        email = md.get("email") or md.get("accountId") or "unknown"
        acc = {"email": email, "fetchedAt": report.get("fetchedAt") or 0, "buckets": {}, "extra": []}
        for limit in report.get("limits") or []:
            merge_limit(acc, limit)
        accounts.append(acc)
    accounts.sort(key=lambda a: a["email"].lower())
    return accounts


def config_env(key: str, default: str | None = None) -> str | None:
    """Read a setting from the environment, honouring both name prefixes.

    The primary prefix follows the invoked program name, so `ompagy` prefers
    `OMPAGY_*` and `omp-manager` prefers `OMP_MANAGER_*`. The other prefix is
    always accepted as a fallback, which keeps old dotfiles working.
    """
    if PROG_NAME == "ompagy":
        order = (f"OMPAGY_{key}", f"OMP_MANAGER_{key}")
    else:
        order = (f"OMP_MANAGER_{key}", f"OMPAGY_{key}")
    for name in order:
        val = os.environ.get(name)
        if val is not None and val != "":
            return val
    return default


def cache_dir() -> str:
    """Cache directory for this program name, kept stable across renames."""
    home = os.path.expanduser("~")
    primary = os.path.join(home, ".cache", PROG_NAME)
    other = os.path.join(home, ".cache", "omp-manager" if PROG_NAME == "ompagy" else "ompagy")
    # Keep using an existing directory so upgrading does not lose cached data.
    if os.path.isdir(other) and not os.path.isdir(primary):
        return other
    os.makedirs(primary, exist_ok=True)
    return primary


def resolve_weights(preset: str) -> tuple[dict, str]:
    """Custom weights from the environment (4 comma-separated numbers) win."""
    raw = config_env("WEIGHTS", "") or ""
    if raw.strip():
        try:
            parts = [float(x) for x in raw.split(",")]
            if len(parts) != len(BUCKETS):
                raise ValueError
            total = sum(parts)
            if total <= 0:
                raise ValueError
            return ({b: p / total for b, p in zip(BUCKETS, parts)}, "custom weights")
        except ValueError:
            sys.stderr.write(f"{PROG_NAME}: ignoring bad weights env var, falling back to preset\n")
    return dict(PRESETS[preset]), preset


def score_account(acc: dict, weights: dict) -> float:
    total = 0.0
    for bucket, weight in weights.items():
        entry = acc["buckets"].get(bucket)
        remaining = entry["remaining"] if entry else 100.0  # unreported window == fresh
        total += weight * max(0.0, min(100.0, remaining))
    return total


def grade(score: float):
    for threshold, letter, word in GRADES:
        if score >= threshold:
            return letter, word
    return "F", "dead"


def exhausted_count(acc: dict) -> int:
    return sum(1 for b in BUCKETS if (e := acc["buckets"].get(b)) and e["remaining"] <= 0)


# --------------------------------------------------------------------- fetch --
def fetch(args, ink: Ink) -> dict:
    if args.input:
        try:
            with open(args.input) as fh:
                return json.load(fh)
        except OSError as exc:
            die(ink, f"cannot read {args.input}: {exc}")
        except json.JSONDecodeError:
            die(ink, f"{args.input} is not valid JSON")
    cmd = ["omp"]
    if args.profile:
        cmd += ["--profile", args.profile]
    if args.refresh:
        subprocess.run(cmd + ["usage", "invalidate", "--provider", PROVIDER],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    cmd += ["usage", "--json"]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=args.timeout)
    except FileNotFoundError:
        die(ink, "omp CLI not found on PATH")
    except subprocess.TimeoutExpired:
        die(ink, f"omp usage timed out after {args.timeout}s")
    if proc.returncode != 0:
        die(ink, "omp usage failed:\n" + (proc.stderr or proc.stdout).strip()[:500])
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        die(ink, "omp usage returned non-JSON output")


def die(ink: Ink, message: str) -> None:
    sys.stderr.write(ink.red(f"{PROG_NAME}: ") + message + "\n")
    raise SystemExit(1)


# --------------------------------------------------------------------- render --
def fmt_reset(entry: dict | None, now_ms: float) -> str:
    """Countdown text of a meter, or "-" when the window has no reset time."""
    if not entry or not entry.get("resetsAt"):
        return "-"
    return fmt_delta(entry["resetsAt"] - now_ms)


def reset_w(accounts: list[dict], now_ms: float) -> int:
    """Width of the reset column: wide enough for the longest countdown.

    Countdowns are variable length ("4h56m", "20h47m", "2d5h"), so the column
    is measured instead of hardcoded - otherwise long values push the rest of
    the row out of its box.
    """
    width = 5
    for a in accounts:
        for b in BUCKETS:
            width = max(width, len(fmt_reset(a["buckets"].get(b), now_ms)))
    return width


def pct_decimals(accounts: list[dict], pct_w: int) -> int:
    """How many decimals the percentage column can afford.

    "100.0%" needs 6 columns, "97.5%" needs 5, "100%" needs 4. The column
    keeps one decimal when it fits and falls back to whole percent when it
    does not - a value must never spill out of its cell.
    """
    max_rem = 0.0
    for a in accounts:
        for b in BUCKETS:
            e = a["buckets"].get(b)
            if e:
                max_rem = max(max_rem, e["remaining"])
    needed = 6 if max_rem >= 99.95 else 5
    return 1 if pct_w >= needed else 0


def cell(ink: Ink, acc: dict, bucket: str, now_ms: float, width_bar: int,
         rw: int, pct_w: int = PCT_W, decimals: int = 1) -> str:
    entry = acc["buckets"].get(bucket)
    tail = ""
    if rw:
        tail = " " + ink.grey(fmt_reset(entry, now_ms).rjust(rw))
    if entry is None:
        return (ink.grey("·" * width_bar) + " " + ink.grey("n/r".rjust(pct_w)) + tail)
    remaining = max(0.0, min(100.0, entry["remaining"]))
    color = remaining_color(ink, remaining)
    pct = f"{remaining:.{decimals}f}%".rjust(pct_w)   # remaining: bar and number agree
    return f"{bar(ink, remaining / 100.0, width_bar, color)} {color(pct)}{tail}"


def get_recoveries(accounts: list[dict], now_ms: float) -> list[dict]:
    recoveries = []
    for a in accounts:
        for b in BUCKETS:
            e = a["buckets"].get(b)
            if e and e["used"] > 0 and e.get("resetsAt") and e["resetsAt"] > now_ms:
                recoveries.append({
                    "email": short(a["email"]),
                    "raw_email": a["email"],
                    "bucket": BUCKET_TITLES[b],
                    "recover_pct": e["used"],
                    "delta": e["resetsAt"] - now_ms,
                    "resetsAt": e["resetsAt"],
                })
        for ex in a.get("extra", []):
            if ex.get("used", 0) > 0 and ex.get("resetsAt") and ex["resetsAt"] > now_ms:
                recoveries.append({
                    "email": short(a["email"]),
                    "raw_email": a["email"],
                    "bucket": ex.get("label", "Extra"),
                    "recover_pct": ex["used"],
                    "delta": ex["resetsAt"] - now_ms,
                    "resetsAt": ex["resetsAt"],
                })
    recoveries.sort(key=lambda x: x["delta"])
    return recoveries


def short(email: str, max_len: int = ACCT_MAX) -> str:
    """Shorten an email to `max_len` visible chars (never longer than that)."""
    if len(email) <= max_len:
        return email
    local, _, domain = email.partition("@")
    if not domain:
        return email[:max_len]
    keep = max_len - len(domain) - 2      # room for "…@"
    if keep < 3:                          # domain alone eats the space
        return email[:max_len - 1] + "…"
    return f"{local[:keep]}…@{domain}"


def acct_w(accounts: list[dict], max_len: int = ACCT_MAX) -> int:
    return max((len(short(a["email"], max_len)) for a in accounts), default=20)


def cell_w(lay: dict, rw: int) -> int:
    return lay["bar"] + 1 + lay["pct"] + (1 + rw if lay["reset"] else 0)


def table_width(accounts: list[dict], lay: dict, rw: int) -> int:
    """Total width of the table, borders included."""
    aw = acct_w(accounts, lay["acct"])
    cw = cell_w(lay, rw)
    grade_w = 9 if lay["word"] else 5
    content = 4 * cw + aw + grade_w
    if lay.get("num", True):
        content += 2
    if lay.get("score", True):
        content += 5
    ncols = 4 + 1 + 1 + int(lay.get("num", True)) + int(lay.get("score", True))
    return content + 3 * (ncols - 1) + 4


def choose_layout(accounts: list[dict], now_ms: float, term_w: int, force: str) -> str:
    """Pick the widest table tier that fits the terminal.

    A table is always returned: the table is the point of the tool, so it
    shrinks (shorter bars, no countdown, shorter emails) rather than turning
    into a stack of cards.
    """
    if force in TIERS:
        return force
    rw = reset_w(accounts, now_ms)
    for name in TIER_ORDER:
        if table_width(accounts, TIERS[name], rw) <= term_w:
            return name
    return TIER_ORDER[-1]


def fit_layout(accounts: list[dict], now_ms: float, term_w: int, name: str) -> dict:
    """Shrink the chosen tier further if it still does not fit.

    Order of sacrifice: first the email column, then the bar, then the
    decimals of the percentage. The table structure itself is never dropped.
    """
    lay = dict(TIERS[name])
    rw = reset_w(accounts, now_ms) if lay["reset"] else 0
    while table_width(accounts, lay, rw) > term_w and lay["acct"] > ACCT_MIN:
        lay["acct"] -= 1
    while table_width(accounts, lay, rw) > term_w and lay["bar"] > 2:
        lay["bar"] -= 1
    while table_width(accounts, lay, rw) > term_w and lay["pct"] > 4:
        lay["pct"] -= 1
    if table_width(accounts, lay, rw) > term_w and lay.get("num", True):
        lay["num"] = False                       # drop the "#" column
    if table_width(accounts, lay, rw) > term_w and lay.get("score", True):
        lay["score"] = False                     # drop the SCORE column
    return lay


def accent_color(ink: Ink, acc: dict, text: str):
    score = acc["score"]
    letter, _ = grade(score)
    return {"S": ink.green, "A": ink.green, "B": ink.cyan, "C": ink.yellow,
            "D": ink.orange, "F": ink.red}.get(letter, ink.grey)(text)


def score_str(ink: Ink, acc: dict) -> str:
    letter, word = grade(acc["score"])
    color = {"S": ink.green, "A": ink.green, "B": ink.cyan, "C": ink.yellow,
             "D": ink.orange, "F": ink.red}.get(letter, ink.grey)
    score_val = f"{acc['score']:>5.1f}"
    return f"{ink.bold(score_val)}  {color(f'{letter} · {word}')}"

def _display_len(s: str) -> int:
    out, i = 0, 0
    while i < len(s):
        if s[i] == "\033":
            while i < len(s) and s[i] != "m":
                i += 1
            i += 1
            continue
        out += 1
        i += 1
    return out


def pad(s: str, width: int) -> str:
    """Right-pad to `width` visible columns, ignoring ANSI escapes."""
    missing = width - _display_len(s)
    return s + " " * missing if missing > 0 else s


def fmt_stamp(ms: float) -> str:
    return datetime.fromtimestamp(ms / 1000, tz=timezone.utc).astimezone().strftime("%Y-%m-%d %H:%M")


def render_table(ink: Ink, accounts: list[dict], now_ms: float, narrow: bool,
                 lay: dict | None = None) -> str:
    rows = []
    lay = lay or TIERS["full"]
    bar_w = lay["bar"]
    pct_w = lay["pct"]
    aw = acct_w(accounts, lay["acct"])
    rw = reset_w(accounts, now_ms) if lay["reset"] else 0
    cw = cell_w(lay, rw)
    dec = pct_decimals(accounts, lay["pct"])
    grade_w = 9 if lay["word"] else 5
    titles = BUCKET_TITLES if lay["titles"] == "long" else BUCKET_TITLES_SHORT
    show_num = lay.get("num", True)
    show_score = lay.get("score", True)
    head_cols = []
    if show_num:
        head_cols.append(("#", 2))
    head_cols += [
        ("ACCOUNT", aw),
        (titles["gemini-5h"], cw),
        (titles["gemini-1w"], cw),
        (titles["shared-5h"], cw),
        (titles["shared-1w"], cw),
    ]
    if show_score:
        head_cols.append(("SCORE", 5))
    head_cols.append(("GRADE", grade_w))

    if not narrow:
        top = ink.grey("╭─" + "─┬─".join("─" * w for _, w in head_cols) + "─╮")
        hdr = ink.grey("│ ") + ink.grey(" │ ").join(ink.bold(pad(title[:w], w)) for title, w in head_cols) + ink.grey(" │")
        mid = ink.grey("├─" + "─┼─".join("─" * w for _, w in head_cols) + "─┤")
        bot = ink.grey("╰─" + "─┴─".join("─" * w for _, w in head_cols) + "─╯")

        rows.append(top)
        rows.append(hdr)
        rows.append(mid)

        for idx, acc in enumerate(accounts, 1):
            letter, word = grade(acc["score"])
            score_val = f"{acc['score']:>5.1f}"
            grade_val = f"{letter} · {word}" if lay["word"] else letter
            c_vals = []
            if show_num:
                c_vals.append(f"{idx:>2}")
            c_vals += [
                accent_color(ink, acc, short(acc["email"], lay["acct"])),
                cell(ink, acc, "gemini-5h", now_ms, bar_w, rw, pct_w, dec),
                cell(ink, acc, "gemini-1w", now_ms, bar_w, rw, pct_w, dec),
                cell(ink, acc, "shared-5h", now_ms, bar_w, rw, pct_w, dec),
                cell(ink, acc, "shared-1w", now_ms, bar_w, rw, pct_w, dec),
            ]
            if show_score:
                c_vals.append(ink.bold(score_val))
            c_vals.append(
                ink.cyan(grade_val) if letter in ("S", "A") else (ink.yellow(grade_val) if letter in ("B", "C") else ink.red(grade_val))
            )
            row_str = ink.grey("│ ") + ink.grey(" │ ").join(pad(v, w) for v, (_, w) in zip(c_vals, head_cols)) + ink.grey(" │")
            rows.append(row_str)

        rows.append(bot)
    else:
        card_w = 72
        left_w = 32
        right_w = card_w - 7 - left_w   # 33
        for idx, acc in enumerate(accounts, 1):
            letter, word = grade(acc["score"])
            title = f" {idx}. {short(acc['email'])} "
            score_tag = f" {acc['score']:>5.1f} · {letter} · {word} "
            dashes = max(2, card_w - 4 - len(title) - len(score_tag))
            top = ink.grey("╭─") + ink.bold(accent_color(ink, acc, title)) + ink.grey("─" * dashes) + ink.cyan(score_tag) + ink.grey("─╮")
            bot = ink.grey("╰" + "─" * (left_w + 2) + "┴" + "─" * (right_w + 2) + "╯")

            row1 = (ink.grey("│ ") + pad(f"{BUCKET_TITLES['gemini-5h']} " + cell(ink, acc, "gemini-5h", now_ms, bar_w, rw, pct_w, dec), left_w) +
                    ink.grey(" │ ") + pad(f"{BUCKET_TITLES['shared-5h']} " + cell(ink, acc, "shared-5h", now_ms, bar_w, rw, pct_w, dec), right_w) + ink.grey(" │"))
            row2 = (ink.grey("│ ") + pad(f"{BUCKET_TITLES['gemini-1w']} " + cell(ink, acc, "gemini-1w", now_ms, bar_w, rw, pct_w, dec), left_w) +
                    ink.grey(" │ ") + pad(f"{BUCKET_TITLES['shared-1w']} " + cell(ink, acc, "shared-1w", now_ms, bar_w, rw, pct_w, dec), right_w) + ink.grey(" │"))
            rows.extend([top, row1, row2, bot, ""])
    return "\n".join(rows)


def render_card(ink: Ink, payload: dict, accounts: list[dict], now_ms: float, narrow: bool, stale: bool, freshest: float, generated: float, term_w: int | None = None) -> list[str]:
    lines = []
    recoveries = get_recoveries(accounts, now_ms)
    cap = (payload.get("capacity") or {}).get(PROVIDER) or []
    cap_5h = next((f"{c['remainingAccounts']:.1f}x 5h" for c in cap if c.get("window") == "5h"), "")
    cap_1w = next((f"{c['remainingAccounts']:.1f}x 1w" for c in cap if c.get("window") == "7d"), "")
    cap_str = " · ".join(filter(None, [cap_5h, cap_1w]))

    def best_for(kind: str):
        cands = [a for a in accounts if (a["buckets"].get(f"{kind}-5h") or {}).get("remaining", 100) > 0
                 or (a["buckets"].get(f"{kind}-1w") or {}).get("remaining", 100) > 0]
        if not cands:
            return None
        return min(cands, key=lambda a: (-min((a["buckets"].get(f"{kind}-5h") or {}).get("remaining", 100.0),
                                              (a["buckets"].get(f"{kind}-1w") or {}).get("remaining", 100.0)),
                                         -a["score"], a["email"].lower()))

    gem = best_for("gemini")
    claude = best_for("shared")

    # Bucket summary, shared by every card style.
    bucket_lines = []
    for b in BUCKETS:
        entries = [a["buckets"].get(b) for a in accounts]
        reported = [e for e in entries if e]
        free_pct = (sum(100.0 - e["used"] for e in reported) / len(reported)) if reported else 100.0
        free_cnt = len([a for a, e in zip(accounts, entries) if not e or e["remaining"] > 0])
        bucket_lines.append((b, free_pct, free_cnt))

    right_lines = []
    gem_str = ink.green(short(gem["email"])) if gem else ink.red("none")
    claude_str = ink.green(short(claude["email"])) if claude else ink.red("none")
    right_lines.append(f"★ Best Gemini : {gem_str}")
    right_lines.append(f"★ Best Claude : {claude_str}")
    if recoveries:
        r0 = recoveries[0]
        right_lines.append(f"⚡ Next relief : {ink.cyan(r0['email'].split('@')[0])} (+{r0['recover_pct']:.0f}% {r0['bucket']} in {fmt_delta(r0['delta'])})")
    else:
        right_lines.append("⚡ Next relief : All quotas 100% full")
    right_lines.append(f"⟳ Pool Cap    : {ink.grey(cap_str if cap_str else 'N/A')}")

    if not narrow:
        left_lines = []
        for b, free_pct, free_cnt in bucket_lines:
            bar_str = bar(ink, max(0.0, min(100.0, free_pct)) / 100.0, 10, remaining_color(ink, free_pct))
            left_lines.append(f"{BUCKET_TITLES[b]:<9} {bar_str} {free_pct:>5.1f}% ({free_cnt}/{len(accounts)} ready)")

        # Column widths are measured, not guessed: a long email or a long
        # countdown must never push a row outside the box.
        lw = max(_display_len(t) for t in left_lines)
        rw = max(_display_len(t) for t in right_lines)
        card_w = lw + rw + 7

        if term_w is not None and card_w > term_w:
            # Slim card for narrow terminals: no frame, no two-column split.
            snap_text = f" snapshot {fmt_age(freshest)}" if not stale else " STALE - rerun with --refresh"
            lines.append(ink.bold(ink.cyan(f"ANTIGRAVITY QUOTA · {len(accounts)} accounts"))
                         + (ink.yellow(snap_text) if stale else ink.grey(snap_text)))
            lines.extend(left_lines)
            lines.extend(right_lines)
            return lines

        header_title = f" ANTIGRAVITY QUOTA · {len(accounts)} accounts "
        snap_text = f" snapshot {fmt_age(freshest)} " if not stale else " STALE - rerun with --refresh "
        mid_dashes = max(2, card_w - 4 - len(header_title) - len(snap_text))
        snap_colored = ink.yellow(snap_text) if stale else ink.grey(snap_text)
        top_line = ink.grey("╭─") + ink.bold(ink.cyan(header_title)) + ink.grey("─" * mid_dashes) + snap_colored + ink.grey("─╮")
        lines.append(top_line)

        div = ink.grey(" │ ")
        border_l = ink.grey("│ ")
        border_r = ink.grey(" │")
        for l_txt, r_txt in zip(left_lines, right_lines):
            lines.append(border_l + pad(l_txt, lw) + div + pad(r_txt, rw) + border_r)

        today_data = get_today_tokens_cached()
        reqs_str = f"{today_data.get('requests', 0):,}"
        in_str = fmt_token_num(today_data.get('in', 0))
        out_str = fmt_token_num(today_data.get('out', 0))
        tot_str = fmt_token_num(today_data.get('total', 0))

        lines.append(ink.grey("├" + "─" * (lw + 2) + "┴" + "─" * (rw + 2) + "┤"))
        today_text = f"⚡ TODAY USAGE : {ink.bold(reqs_str)} reqs  ·  In: {ink.cyan(in_str)}  ·  Out: {ink.green(out_str)}  ·  Total: {ink.bold(ink.yellow(tot_str))} tokens"
        inner_w = lw + rw + 3
        lines.append(border_l + pad(today_text, inner_w) + border_r)
        lines.append(ink.grey("╰" + "─" * (inner_w + 2) + "╯"))
    else:
        card_w = 72
        header_title = f" ANTIGRAVITY QUOTA · {len(accounts)} accounts "
        snap_text = f" {fmt_age(freshest)} " if not stale else " STALE "
        dashes = max(2, card_w - 4 - len(header_title) - len(snap_text))
        snap_colored = ink.yellow(snap_text) if stale else ink.grey(snap_text)
        top_line = ink.grey("╭─") + ink.bold(ink.cyan(header_title)) + ink.grey("─" * dashes) + snap_colored + ink.grey("─╮")
        lines.append(top_line)

        for b, free_pct, free_cnt in bucket_lines:
            bar_str = bar(ink, max(0.0, min(100.0, free_pct)) / 100.0, 12, remaining_color(ink, free_pct))
            content = f" {BUCKET_TITLES[b]:<9} {bar_str} {free_pct:>5.1f}% ({free_cnt}/{len(accounts)} ready)"
            lines.append(ink.grey("│") + pad(content, card_w - 2) + ink.grey("│"))

        lines.append(ink.grey("├" + "─" * (card_w - 2) + "┤"))

        lines.append(ink.grey("│") + pad(f" ★ Best Gemini : {gem_str}", card_w - 2) + ink.grey("│"))
        lines.append(ink.grey("│") + pad(f" ★ Best Claude : {claude_str}", card_w - 2) + ink.grey("│"))
        if recoveries:
            r0 = recoveries[0]
            lines.append(ink.grey("│") + pad(f" ⚡ Next relief : {ink.cyan(r0['email'].split('@')[0])} (+{r0['recover_pct']:.0f}% {r0['bucket']} in {fmt_delta(r0['delta'])})", card_w - 2) + ink.grey("│"))
        today_data = get_today_tokens_cached()
        reqs_str = f"{today_data.get('requests', 0):,}"
        in_str = fmt_token_num(today_data.get('in', 0))
        out_str = fmt_token_num(today_data.get('out', 0))
        tot_str = fmt_token_num(today_data.get('total', 0))
        lines.append(ink.grey("│") + pad(f" ⟳ Pool Cap    : {ink.grey(cap_str if cap_str else 'N/A')}", card_w - 2) + ink.grey("│"))
        lines.append(ink.grey("├" + "─" * (card_w - 2) + "┤"))
        today_text = f" ⚡ TODAY USAGE : {ink.bold(reqs_str)} reqs · In: {ink.cyan(in_str)} · Out: {ink.green(out_str)} · Total: {ink.bold(ink.yellow(tot_str))}"
        lines.append(ink.grey("│") + pad(today_text, card_w - 2) + ink.grey("│"))
        lines.append(ink.grey("╰" + "─" * (card_w - 2) + "╯"))

    return lines


def render_mini(ink: Ink, payload: dict, accounts: list[dict], now_ms: float) -> str:
    g5 = [a["buckets"].get("gemini-5h") for a in accounts]
    g5_rep = [e for e in g5 if e]
    g5_rem = (100 - (sum(e["used"] for e in g5_rep) / len(g5_rep))) if g5_rep else 100.0
    g5_cnt = len([a for a, e in zip(accounts, g5) if not e or e["remaining"] > 0])

    g1 = [a["buckets"].get("gemini-1w") for a in accounts]
    g1_rep = [e for e in g1 if e]
    g1_rem = (100 - (sum(e["used"] for e in g1_rep) / len(g1_rep))) if g1_rep else 100.0
    g1_cnt = len([a for a, e in zip(accounts, g1) if not e or e["remaining"] > 0])

    best = accounts[0]
    letter, _ = grade(best["score"])

    parts = [
        f"{ink.bold('[AGY ' + str(len(accounts)) + 'acc]')}",
        f"G5h: {remaining_color(ink, g5_rem)(f'{g5_rem:.0f}%')} ({g5_cnt}/{len(accounts)})",
        f"G1w: {remaining_color(ink, g1_rem)(f'{g1_rem:.0f}%')} ({g1_cnt}/{len(accounts)})",
        f"Best: {ink.green(short(best['email']).split('@')[0])} ({best['score']:.0f} {letter})",
    ]
    recoveries = get_recoveries(accounts, now_ms)
    if recoveries:
        r0 = recoveries[0]
        parts.append(f"Next: {ink.cyan(r0['email'].split('@')[0])} (+{r0['recover_pct']:.0f}% in {fmt_delta(r0['delta'])})")
    today_data = get_today_tokens_cached()
    parts.append(f"Today: {fmt_token_num(today_data.get('requests', 0))} reqs, {fmt_token_num(today_data.get('total', 0))} tok")
    return " · ".join(parts)


def render(ink: Ink, payload: dict, accounts: list[dict], args, weights: dict, preset: str) -> str:
    now_ms = time.time() * 1000
    generated = payload.get("generatedAt") or now_ms
    ages = [now_ms - a["fetchedAt"] for a in accounts if a["fetchedAt"]]
    freshest = min(ages) if ages else 0
    oldest = max(ages) if ages else 0
    stale = oldest > args.stale * 1000

    term_w = term_width()
    stacked = args.narrow or args.layout == "stack"
    if stacked:
        is_narrow = True
        lay = TIERS["full"]
    else:
        is_narrow = False
        name = choose_layout(accounts, now_ms, term_w, args.layout)
        lay = fit_layout(accounts, now_ms, term_w, name)

    out = render_card(ink, payload, accounts, now_ms, narrow=is_narrow, stale=stale,
                      freshest=freshest, generated=generated, term_w=term_w)
    out.append("")
    out.append(ink.bold("RANKING  " + ink.grey(f"(best -> worst · ranked by {preset})")))
    out.append(render_table(ink, accounts, now_ms, narrow=is_narrow, lay=lay))
    out.append("")

    extras = [(a["email"], e) for a in accounts for e in a["extra"]]
    if extras:
        out.append(ink.bold("OTHER METERS") + ink.grey("  (not part of the score)"))
        for email, e in extras:
            reset = f"reset {fmt_delta(e['resetsAt'] - now_ms)}" if e.get("resetsAt") else ""
            left_pct = 100 - e["used"]
            out.append(f"  {pad(short(email, lay['acct']), lay['acct'])}  {pad(e['label'], 16)} "
                       f"{ink.grey(f'{left_pct:>5.1f}% left · {reset}')}")
        out.append("")
    for name in ("accountsWithoutUsage", "disabledCredentials"):
        rows = payload.get(name) or []
        if rows:
            out.append(ink.bold(name.upper()))
            for r in rows:
                out.append("  " + (r if isinstance(r, str) else json.dumps(r))[:120])
            out.append("")

    short_titles = BUCKET_TITLES_SHORT if lay["titles"] == "short" else BUCKET_TITLES
    grades_txt = " ".join(f"{letter}≥{thr}" for thr, letter, _ in GRADES[:-1]) + " F<15"
    if term_w >= 170:
        out.append(ink.grey(f"bar & % = quota remaining  ·  grade: {grades_txt}"))
        out.append(ink.grey(f"score weights ({preset}): "
                            + "  ".join(f"{BUCKET_TITLES[b]} {weights[b]:.2f}" for b in BUCKETS)
                            + " · n/r = window not reported (counted as fresh)"
                            + " · switch with --by gemini|balanced|claude"))
    elif term_w >= 80:
        out.append(ink.grey(f"bar & % = quota remaining  ·  grade: {grades_txt}"))
        out.append(ink.grey(f"weights ({preset}): "
                            + " ".join(f"{short_titles[b]} {weights[b]:.2f}" for b in BUCKETS)
                            + " · n/r = not reported"))
    else:
        out.append(ink.grey(f"bar & % = remaining · {grades_txt}"))
        out.append(ink.grey(f"weights: "
                            + " ".join(f"{short_titles[b]} {weights[b]:.2f}" for b in BUCKETS)))
    return "\n".join(out)

def term_width() -> int:
    env = os.environ.get("COLUMNS")
    if env and env.isdigit():
        return int(env)
    return shutil.get_terminal_size((120, 24)).columns


